# Settings for docker-compose.yml. Copy this file to .env and edit it.
# .env is git-ignored, so the password stays on your machine.

# Required: the password for the PostgreSQL database container.
DB_PASSWORD=change-me

# Optional: the host port the app is published on (default 8080).
# MUSICDASHBOARD_PORT=8080

# Optional: the folder with your music (default ~/Music).
# MUSIC_DIR=/path/to/your/music
